rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNote(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             (!('content' in data) || (data.content is string && data.content.size() <= 50000)) &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 64)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('isFavorite' in data) || data.isFavorite is bool) &&
             (!('isArchived' in data) || data.isArchived is bool) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 32)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCategory(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 50 &&
             (!('color' in data) || (data.color is string && data.color.size() <= 32)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 32)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped collections
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /notes/{noteId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'title', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'categoryId', 'tags', 'isPinned', 'isFavorite', 'isArchived', 'color', 'createdAt', 'updatedAt']) &&
                         isValidNote(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNote(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'categoryId', 'tags', 'isPinned', 'isFavorite', 'isArchived', 'color', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /categories/{categoryId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'name', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'color', 'icon', 'createdAt', 'updatedAt']) &&
                         isValidCategory(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidCategory(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'icon', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
